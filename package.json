    "@tanstack/react-query-devtools": "^4.33.0",
    "framer-motion": "^14.5.0",
    "lucide-react": "^1.61.0",
    "next": "^13.4.19",
    "next-auth": "^4.19.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.0.2",
    "sharp": "^0.32.5",
    "styled-components": "^6.0.7",
